{
  "name": "@htk/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server: WebSocket + MessagePack, 20 Hz zones (docs/architecture/server-design.md)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/main.js --external:ws --external:@msgpack/msgpack --external:zod --external:yaml --external:pg --external:ioredis",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "map:check": "tsx src/map-check.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@htk/shared": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "ws": "^8.23.0",
    "zod": "^3.25.76",
    "@htk/content": "workspace:*",
    "yaml": "^2.8.1",
    "@htk/db": "workspace:*",
    "ioredis": "^5.8.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
