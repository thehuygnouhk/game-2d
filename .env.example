# Copy to .env (never commit .env). Values match docs/guides/developer-setup-guide.md §4.
DATABASE_URL=postgresql://htk:htk@localhost:5432/htk
REDIS_URL=redis://localhost:6379
# Sign-in keys: any long random string in development; 32+ random characters, kept secret, in production
JWT_SECRET=change-me-dev-only-0123456789abcdef
API_PORT=3000
# Routes under /api (the web client and the reverse proxy expect it)
API_PREFIX=/api
GAME_WS_PORT=7001
REALM_ID=1
# Server tests only: also accept "guest:<name>" tickets (no account, nothing saved). Never enable in production.
DEV_GUEST=0
# The game server reads this file by itself in development (apps/game-server/src/main.ts).
# Optional: CONTENT_DIR, MAP_DIR (defaults: packages/content, art/prototype/maps), GAME_SEED (tests only)
