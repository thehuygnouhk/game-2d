{
  "name": "@htk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema (SQL migrations), connection, transactions and repositories (docs/architecture/database-schema.md)",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'test/**/*.int.test.ts'",
    "test:int": "vitest run test",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "reset": "tsx src/cli.ts reset"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
