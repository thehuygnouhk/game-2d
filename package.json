{
  "name": "htk",
  "private": true,
  "description": "Huyền Thư Ký: 2D side-scrolling MMORPG (monorepo)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,server,client -c magenta,yellow,cyan \"pnpm dev:api\" \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "pnpm --filter @htk/web-client dev",
    "dev:server": "pnpm --filter @htk/game-server dev",
    "dev:api": "pnpm --filter @htk/api dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:int": "pnpm -r --workspace-concurrency=1 --if-present test:int",
    "test:e2e": "pnpm --filter @htk/web-client test:e2e",
    "content:validate": "pnpm --filter @htk/content validate",
    "content:build": "node tools/checks/not-yet.mjs content:build B3",
    "map:check": "pnpm --filter @htk/game-server map:check",
    "db:migrate": "pnpm --filter @htk/db migrate",
    "db:seed": "pnpm --filter @htk/db seed",
    "db:reset": "pnpm --filter @htk/db reset",
    "sim:exp": "python3 tools/sim/chapter1.py",
    "sim:ttk": "node tools/checks/not-yet.mjs sim:ttk B2",
    "sim:economy": "node tools/checks/not-yet.mjs sim:economy C",
    "bots": "node tools/checks/not-yet.mjs bots B2",
    "load:ws": "node tools/checks/not-yet.mjs load:ws B2",
    "check:ip": "node tools/checks/ip-leak.mjs",
    "check:links": "node tools/checks/links.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
